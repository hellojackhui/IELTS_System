# Copy to .env and adjust. Loaded by the server in dev (dotenv).
PORT=8787
DB_PATH=data.db
# Change this to a long random string before deploying anywhere real.
JWT_SECRET=dev-secret-change-me-in-production

# AI relay (OpenAI-compatible). Required for AI 助手 / 语境填空 / 写作批改 / 阅读.
AI_BASE_URL=https://aiberm.org/v1
AI_API_KEY=sk-your-key-here
AI_MODEL=glm-5.3
