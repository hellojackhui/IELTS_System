# Copy to .env (gitignored) next to docker-compose.yml for production deploys.
# docker compose substitutes these into the server container.

# Required: a long random string. Generate with: openssl rand -hex 32
JWT_SECRET=

# AI relay (OpenAI-compatible)
AI_BASE_URL=https://aiberm.org/v1
AI_API_KEY=
AI_MODEL=glm-5.3
